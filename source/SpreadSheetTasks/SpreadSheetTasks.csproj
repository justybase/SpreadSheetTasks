<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
	<Nullable>enable</Nullable>
	<IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <WarningsAsErrors>IL2026;IL2027;IL2093;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056;IL3057;IL3058;IL3059;IL3060;IL3061;IL3062;IL3063;IL3064;IL3065</WarningsAsErrors>
	<RootNamespace>SpreadSheetTasks</RootNamespace>
    <Authors>Krzysztof Duśko</Authors>
	<Company>Krzysztof Duśko</Company>
    <Description>High-performance .NET library for reading and writing Excel files (.xlsx, .xlsb), with streaming APIs and NativeAOT validation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
	 <Version>2.0.0</Version>
	<LangVersion>latest</LangVersion>
    <PackageReleaseNotes>Breaking: GetRowsOfSheet now returns a new array per row; use GetRowsOfSheetReadOnly for the reused-buffer scan. Adds reusable cell styles for header rows and A1 ranges (XLSX alignment and wrapping included), preserves number, date and boolean types in untyped columns, escapes ST_Xstring and CR in shared and inline strings, recognises date formats by token, and keeps the full width of sparse rows.</PackageReleaseNotes>
    <PackageTags>xlsx;xlsb;excel;spreadsheets;nativeaot;aot;trimming</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/KrzysztofDusko/SpreadSheetTasks</RepositoryUrl>
    <PackageProjectUrl>https://github.com/KrzysztofDusko/SpreadSheetTasks</PackageProjectUrl>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	  <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
