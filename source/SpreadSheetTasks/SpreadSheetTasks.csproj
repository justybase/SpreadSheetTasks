<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
	<Nullable>enable</Nullable>
	<IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <WarningsAsErrors>IL2026;IL2027;IL2093;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056;IL3057;IL3058;IL3059;IL3060;IL3061;IL3062;IL3063;IL3064;IL3065</WarningsAsErrors>
	<RootNamespace>SpreadSheetTasks</RootNamespace>
    <Authors>Krzysztof Duśko</Authors>
	<Company>Krzysztof Duśko</Company>
    <Description>High-performance .NET library for reading and writing Excel files (.xlsx, .xlsb), with streaming APIs and NativeAOT validation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
	 <Version>2.1.0</Version>
	<LangVersion>latest</LangVersion>
    <PackageReleaseNotes>Default ZIP compression is now zlib level 3 for both XLSX and XLSB through a built-in ZIP writer, making writes 13-21% faster at a slightly larger file size; pass an explicit CompressionLevel to keep the previous enum-based behaviour. XLSB adds useSharedStrings: false for inline strings, row writes are buffered, shared strings are encoded in bulk, and ExcelReaderAbstract.CurrentRow exposes the current row as ReadOnlySpan&lt;FieldInfo&gt; without boxing. Readers now open files read-only with FileShare.Read, so read-only files and concurrent readers work.</PackageReleaseNotes>
    <PackageTags>xlsx;xlsb;excel;spreadsheets;nativeaot;aot;trimming</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/KrzysztofDusko/SpreadSheetTasks</RepositoryUrl>
    <PackageProjectUrl>https://github.com/KrzysztofDusko/SpreadSheetTasks</PackageProjectUrl>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	  <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
